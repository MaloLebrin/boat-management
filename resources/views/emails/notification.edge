{{--
  Notification livrée par e-mail (#888) : titre, corps et lien de la
  notification in-app, textes déjà traduits par
  `EmailQueueService.sendNotification`.
--}}
@component('emails/_layout')
  @slot('content')
    <p style="margin:0 0 15px;color:#555555;font-size:16px;line-height:1.5;">{{ greeting }}</p>
    <h2 style="margin:0 0 20px;color:#333333;font-size:22px;">{{ title }}</h2>
    @if(body)
      <p style="margin:0 0 25px;color:#555555;font-size:16px;line-height:1.5;">{{ body }}</p>
    @end
    @if(ctaUrl)
      <table role="presentation" cellspacing="0" cellpadding="0" style="margin:10px auto 0;">
        <tr>
          <td style="border-radius:6px;background-color:#1e3a5f;">
            <a
              href="{{ ctaUrl }}"
              style="display:inline-block;padding:14px 30px;color:#ffffff;text-decoration:none;font-size:16px;font-weight:bold;"
            >
              {{ ctaLabel }}
            </a>
          </td>
        </tr>
      </table>
    @end
    @include('emails/_notification_footer')
  @end
@end
