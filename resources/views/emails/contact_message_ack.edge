@component('emails/_layout')
  @slot('content')
    <h2 style="margin:0 0 20px;color:#333333;font-size:22px;">
      {{ t('marketing.emails.contactAck.heading', { firstName }) }}
    </h2>
    <p style="margin:0 0 15px;color:#555555;font-size:16px;line-height:1.5;">
      {{ t('marketing.emails.contactAck.intro') }}
    </p>
    <p style="margin:0 0 10px;color:#888888;font-size:13px;">
      {{ t('marketing.emails.contactAck.copyLabel') }}
    </p>

    <div
      style="padding:16px;background-color:#f4f4f7;border-radius:6px;color:#333333;font-size:15px;line-height:1.6;"
    >
      @each(line in messageLines)
        <p style="margin:0 0 6px;">{{ line }}</p>
      @end
    </div>
    <table role="presentation" cellspacing="0" cellpadding="0" style="margin:25px auto 0;">
      <tr>
        <td style="border-radius:6px;background-color:#1e3a5f;">
          <a
            href="{{ appUrl }}/signup"
            style="display:inline-block;padding:14px 30px;color:#ffffff;text-decoration:none;font-size:16px;font-weight:bold;"
          >
            {{ t('marketing.emails.contactAck.cta') }}
          </a>
        </td>
      </tr>
    </table>
  @end
@end
