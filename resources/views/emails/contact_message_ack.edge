@component('emails/_layout')
  @slot('content')
    @if(locale === 'fr')
      <h2 style="margin:0 0 20px;color:#333333;font-size:22px;">Bien reçu, {{ firstName }} 👋</h2>
      <p style="margin:0 0 15px;color:#555555;font-size:16px;line-height:1.5;">
        Merci pour votre message. Un membre de l'équipe FleetAi vous répond sous 4 heures en jours ouvrés — pas de bot, c'est l'un de nous qui vous lit.
      </p>
      <p style="margin:0 0 10px;color:#888888;font-size:13px;">Copie de votre message</p>
    @else
      <h2 style="margin:0 0 20px;color:#333333;font-size:22px;">Got it, {{ firstName }} 👋</h2>
      <p style="margin:0 0 15px;color:#555555;font-size:16px;line-height:1.5;">
        Thanks for reaching out. A member of the FleetAi team will get back to you within 4 hours on business days — no bot, one of us reads you.
      </p>
      <p style="margin:0 0 10px;color:#888888;font-size:13px;">A copy of your message</p>
    @end

    <div
      style="padding:16px;background-color:#f4f4f7;border-radius:6px;color:#333333;font-size:15px;line-height:1.6;"
    >
      @each(line in messageLines)
        <p style="margin:0 0 6px;">{{ line }}</p>
      @end
    </div>
    <table role="presentation" cellspacing="0" cellpadding="0" style="margin:25px auto 0;">
      <tr>
        <td style="border-radius:6px;background-color:#1e3a5f;">
          <a
            href="{{ appUrl }}/signup"
            style="display:inline-block;padding:14px 30px;color:#ffffff;text-decoration:none;font-size:16px;font-weight:bold;"
          >
            @if(locale === 'fr')
              Tester FleetAi 14 jours
            @else
              Try FleetAi for 14 days
            @end
          </a>
        </td>
      </tr>
    </table>
  @end
@end
