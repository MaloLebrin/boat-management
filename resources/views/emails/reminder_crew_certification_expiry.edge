{{--
  Certifications d'équipage à renouveler (#882) : envoyé aux admins à 60, 30
  et 7 jours de l'échéance. Textes traduits dans la langue du destinataire.
--}}
@component('emails/_layout', { branding })
  @slot('content')
    <h2 style="margin:0 0 20px;color:#333333;font-size:22px;">
      {{ i18n.t('crew.emails.reminder.greeting', { name: displayName }) }}
    </h2>
    <p style="margin:0 0 20px;color:#555555;font-size:16px;line-height:1.5;">{{ intro }}</p>

    <table
      role="presentation"
      width="100%"
      cellspacing="0"
      cellpadding="0"
      style="margin:0 0 25px;border:1px solid #eeeeee;border-radius:6px;"
    >
      <thead>
        <tr>
          <th
            style="padding:10px 15px;text-align:left;background-color:#f4f4f7;color:#555555;font-size:12px;text-transform:uppercase;"
          >
            {{ i18n.t('crew.emails.reminder.columns.member') }}
          </th>
          <th
            style="padding:10px 15px;text-align:left;background-color:#f4f4f7;color:#555555;font-size:12px;text-transform:uppercase;"
          >
            {{ i18n.t('crew.emails.reminder.columns.certification') }}
          </th>
          <th
            style="padding:10px 15px;text-align:left;background-color:#f4f4f7;color:#555555;font-size:12px;text-transform:uppercase;"
          >
            {{ i18n.t('crew.emails.reminder.columns.expiresAt') }}
          </th>
        </tr>
      </thead>
      <tbody>
        @each(row in rows)
          <tr>
            <td
              style="padding:10px 15px;border-bottom:1px solid #eeeeee;color:#333333;font-size:14px;"
            >
              {{ row.crewMemberName }}
            </td>
            <td
              style="padding:10px 15px;border-bottom:1px solid #eeeeee;color:#555555;font-size:14px;"
            >
              {{ row.type }}
            </td>
            <td
              style="padding:10px 15px;border-bottom:1px solid #eeeeee;color:#e07000;font-size:14px;"
            >
              {{ row.expiresAt }}
              ({{ row.delay }})
            </td>
          </tr>
        @end
      </tbody>
    </table>
    <table role="presentation" cellspacing="0" cellpadding="0" style="margin:0 auto;">
      <tr>
        <td style="border-radius:6px;background-color:#1e3a5f;">
          <a
            href="{{ appUrl }}/crew"
            style="display:inline-block;padding:14px 30px;color:#ffffff;text-decoration:none;font-size:16px;font-weight:bold;"
          >
            {{ i18n.t('crew.emails.reminder.cta') }}
          </a>
        </td>
      </tr>
    </table>
  @end
@end
