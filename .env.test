SESSION_DRIVER=memory
QUEUE_DRIVER=sync

# Aligné sur le service `postgres_test` du docker-compose (profil `test`, port
# hôte 5432) et sur le bloc `env:` des jobs de tests de la CI. Le Postgres de
# dev, lui, écoute sur 5431 avec les identifiants `3d-website` : y pointer
# faisait échouer `pnpm test` sur une base inexistante.
DB_HOST=localhost
DB_PORT=5432
DB_USER=test
DB_PASSWORD=test
DB_DATABASE=test

# Stripe — clé vide en test : force StripeNotConfiguredError et empêche tout appel réseau réel
STRIPE_SECRET_KEY=
# Secret de signature des webhooks — valeur factice, ce n'est pas un secret : la
# vérification est purement locale (HMAC SHA-256 sur le corps brut), sans appel
# réseau ni clé API. Elle permet à `tests/support/stripe.ts` de signer ses
# fixtures et donc d'exercer la vraie vérification, cas invalide compris.
STRIPE_WEBHOOK_SECRET=whsec_test_secret
# Stripe price IDs — valeurs factices pour un mapping priceId↔tier/module déterministe en test
STRIPE_PRO_MONTHLY_PRICE_ID=price_test_pro_month
STRIPE_PRO_ANNUAL_PRICE_ID=price_test_pro_year
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=price_test_ent_month
STRIPE_ENTERPRISE_ANNUAL_PRICE_ID=price_test_ent_year
STRIPE_MODULE_CHARTER_MONTHLY_PRICE_ID=price_test_charter_month
STRIPE_MODULE_CHARTER_ANNUAL_PRICE_ID=price_test_charter_year
STRIPE_MODULE_CRM_INVOICING_MONTHLY_PRICE_ID=price_test_crm_month
STRIPE_MODULE_CRM_INVOICING_ANNUAL_PRICE_ID=price_test_crm_year
STRIPE_ADDON_EXTRA_BOATS_MONTHLY_PRICE_ID=price_test_extra_boats_month
STRIPE_ADDON_EXTRA_BOATS_ANNUAL_PRICE_ID=price_test_extra_boats_year

# Formulaire de contact (#450) — destinataire déterministe pour les assertions de test
CONTACT_INBOX_EMAIL=contact-test@fleetai.app
