# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_DATABASE=

# App
LOG_LEVEL=info
APP_NAME=3d-website
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie
QUEUE_DRIVER=database

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Mail (SMTP)
# Web Push (#497) — optionnel : sans clés, le push est désactivé.
# Générer une paire : npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=noreply@fleetai.app
MAIL_FROM_NAME=FleetAi
# Destinataire des messages du formulaire de contact — vide = MAIL_FROM_ADDRESS
CONTACT_INBOX_EMAIL=hello@fleetai.app

# Mentions légales (#466) — identité affichée sur /fr/mentions-legales et
# /en/legal-notice. Obligatoire en production (LCEN art. 6-III) : un champ vide
# s'affiche « à compléter » sur la page publique.
LEGAL_COMPANY_NAME=
LEGAL_LEGAL_FORM=
LEGAL_SHARE_CAPITAL=
LEGAL_REGISTRATION_NUMBER=
LEGAL_VAT_NUMBER=
LEGAL_ADDRESS=
LEGAL_CONTACT_EMAIL=support@fleetai.app
LEGAL_CONTACT_PHONE=
LEGAL_PUBLICATION_DIRECTOR=
LEGAL_HOST_NAME=
LEGAL_HOST_ADDRESS=
LEGAL_HOST_CONTACT=
# Médiateur de la consommation (obligatoire pour un service vendu à des
# consommateurs — art. L612-1 du code de la consommation)
LEGAL_MEDIATOR_NAME=
LEGAL_MEDIATOR_URL=

# Demo sandbox
DEMO_EMAIL=demo@fleetai.app
DEMO_PASSWORD=demo1234

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
STRIPE_ENTERPRISE_MONTHLY_PRICE_ID=
STRIPE_ENTERPRISE_ANNUAL_PRICE_ID=
# Modules add-ons (épic #327) — prix récurrents EUR : mensuel 15 €, annuel 144 €
STRIPE_MODULE_CHARTER_MONTHLY_PRICE_ID=
STRIPE_MODULE_CHARTER_ANNUAL_PRICE_ID=
STRIPE_MODULE_CRM_INVOICING_MONTHLY_PRICE_ID=
STRIPE_MODULE_CRM_INVOICING_ANNUAL_PRICE_ID=
# Add-ons quantitatifs (épic #333) — prix récurrent par unité (ex. 4 €/bateau/mois)
STRIPE_ADDON_EXTRA_BOATS_MONTHLY_PRICE_ID=
STRIPE_ADDON_EXTRA_BOATS_ANNUAL_PRICE_ID=
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_CUSTOMER_PORTAL_ID=
STRIPE_ADDON_EXTRA_BOATS_MONTHLY_PRICE_ID=
STRIPE_ADDON_EXTRA_BOATS_ANNUAL_PRICE_ID=
