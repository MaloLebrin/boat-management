        "eyebrow": "WHAT GUIDES US",
        "title": "Four",
        "titleHighlight": "non-negotiable principles.",
        "items": [
          {
            "n": "01",
            "title": "Field first",
            "desc": "Every feature is tested on a dock before it ships. We go to see Marc, Yann and Sophie — not the other way around.",
            "extra": "In 2025, the team spent 84 days in the field."
          },
          {
            "n": "02",
            "title": "Immutable data",
            "desc": "An entry cannot be modified. That's the contract. Your fleet's traceability is worth as much as a boat.",
            "extra": "28,240 events stored since 2024. Zero lost."
          },
          {
            "n": "03",
            "title": "No AI bullshit",
            "desc": "FleetAi suggests, it doesn't decide. You stay the captain. AI is useful when it's honest about its limits.",
            "extra": "Your data is never used to train the model."
          },
          {
            "n": "04",
            "title": "One tide for bugs",
            "desc": "Critical bugs are fixed within 6 hours. Others within 7 days. No rotten backlog.",
            "extra": "Median resolution time in 2025: 3h47."
